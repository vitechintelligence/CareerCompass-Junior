DATABASE_URL=postgresql://runtime_login:password@YOUR-NEON-HOST/neondb?sslmode=require
# Migration owner: only for scripts/manage.py, never a browser/VITE_/NEXT_PUBLIC_ variable.
MIGRATION_DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:8000
APP_ENV=development
# Set a random 32+ character secret. HMACs rate-limit identifiers; never logs IP addresses.
RATE_LIMIT_SECRET=
# Explicit opt-in. Core workflows do not require hosted AI.
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=career-compass-lms
