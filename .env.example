# Authoritative Neon production identity for Career Compass LMS.
# Project ID is non-secret and should be declared in Vercel so runtime alignment can be verified.
NEON_PROJECT_ID=royal-queen-79814128
# Set this to the actual production/default branch ID after verifying it in Neon.
NEON_BRANCH_ID=br-your-production-branch

# Neon pooled connection string from the SAME project/branch as NEON_AUTH_BASE_URL.
# Configure this in Vercel; never commit a real credential.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Local/dev app URL. Production is pinned in code to:
# https://career-compass-junior-vitech.vercel.app
# Add that exact HTTPS origin to the Neon Auth branch trusted domains.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Auth endpoint from the SAME Career Compass LMS project/branch as DATABASE_URL.
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth

# Server-only secret used to sign cached auth session data. Minimum 32 characters.
# Generate independently for deployment, for example: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-a-long-random-secret

# Comma-separated verified account emails allowed to bootstrap platform_admin.
# Default code also allows labellesolutionservices@gmail.com.
PLATFORM_ADMIN_EMAILS=labellesolutionservices@gmail.com


# Optional LangSmith observability for approved server-side AI/workflow operations.
# Keep disabled by default. Never trace raw student work, recordings, email, names or BYOK secrets.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=career-compass-junior
# Optional for self-hosted / institution-controlled LangSmith deployments.
LANGSMITH_ENDPOINT=

# VinaSkillTrust Junior company invitation delivery.
# Use a verified sender/domain in production; keep credentials server-only.
RESEND_API_KEY=
VST_JUNIOR_FROM_EMAIL=VinaSkillTrust Junior <connect@your-verified-domain.example>

# Optional Ask Mr. Vi public company-contact lookup.
# The lookup is constrained to public, verifiable company contact information.
OPENAI_API_KEY=
MR_VI_MODEL=gpt-5.6-luna
